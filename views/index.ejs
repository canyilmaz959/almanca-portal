<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Almanca A1 Çalışma Portalı - <%= lesson.title %></title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Özel CSS Dosyası -->
    <link rel="stylesheet" href="/style.css">
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">

    <!-- Üst Navigasyon -->
    <header class="bg-indigo-700 text-white shadow-lg sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-wrap items-center justify-between py-3 gap-3">
                <div class="flex items-center space-x-3">
                    <span class="text-2xl">🇩🇪</span>
                    <div>
                        <span class="font-bold text-lg sm:text-xl tracking-tight block leading-none">Almanca A1 Çalışma Portalı</span>
                        <span class="text-xs text-indigo-200"><%= lesson.book %> • <%= lesson.date %></span>
                    </div>
                </div>

                <!-- Ders Seçici Dropdown -->
                <div class="flex items-center gap-2">
                    <label for="lesson-select" class="text-xs font-medium text-indigo-200 hidden sm:inline">Ders Seç:</label>
                    <select id="lesson-select" onchange="window.location.href='/?ders=' + this.value" class="bg-indigo-800 text-white text-xs sm:text-sm font-semibold px-3 py-2 rounded-lg border border-indigo-500 focus:outline-none focus:ring-2 focus:ring-amber-400 cursor-pointer">
                        <% lessons.forEach(function(l) { %>
                            <option value="<%= l.id %>" <%= l.id === lesson.id ? 'selected' : '' %>>
                                <%= l.title %> (<%= l.date %>)
                            </option>
                        <% }); %>
                    </select>
                </div>
            </div>

            <!-- Sekmeler -->
            <nav class="flex overflow-x-auto no-scrollbar py-2 space-x-1.5 text-xs sm:text-sm font-medium border-t border-indigo-600/80">
                <button onclick="switchTab('summary')" class="nav-btn px-3 py-2 rounded-lg transition-colors bg-indigo-900 text-white whitespace-nowrap" id="nav-summary">
                    📚 Konu Özeti
                </button>
                <button onclick="switchTab('verbs')" class="nav-btn px-3 py-2 rounded-lg transition-colors hover:bg-indigo-600 text-indigo-100 whitespace-nowrap" id="nav-verbs">
                    🔄 Fiil Rehberi (<%= lesson.verbs ? lesson.verbs.length : 0 %>)
                </button>
                <button onclick="switchTab('dictionary')" class="nav-btn px-3 py-2 rounded-lg transition-colors hover:bg-indigo-600 text-indigo-100 whitespace-nowrap" id="nav-dictionary">
                    📖 Sözlük (<%= lesson.dictionary ? lesson.dictionary.length : 0 %>)
                </button>
                <button onclick="switchTab('flashcards')" class="nav-btn px-3 py-2 rounded-lg transition-colors hover:bg-indigo-600 text-indigo-100 whitespace-nowrap" id="nav-flashcards">
                    🎴 Çalışma Kartları (<%= lesson.flashcards ? lesson.flashcards.length : 0 %>)
                </button>
                <button onclick="switchTab('exercises')" class="nav-btn px-3 py-2 rounded-lg transition-colors hover:bg-indigo-600 text-indigo-100 whitespace-nowrap" id="nav-exercises">
                    ✍️ Alıştırmalar (<%= lesson.exercises ? lesson.exercises.length : 0 %>)
                </button>
                <button onclick="switchTab('quiz')" class="nav-btn px-3 py-2 rounded-lg transition-colors hover:bg-indigo-600 text-indigo-100 whitespace-nowrap" id="nav-quiz">
                    📝 Ders Sonu Sınavı (<%= lesson.quiz ? lesson.quiz.length : 0 %>)
                </button>
            </nav>
        </div>
    </header>

    <!-- Ana İçerik Konteyneri -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">

        <!-- SEKME 1: KONU ÖZETİ -->
        <section id="tab-summary" class="tab-content space-y-6">
            <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div>
                    <div class="flex items-center gap-2">
                        <span class="text-xs font-bold uppercase tracking-wider text-indigo-600 bg-indigo-50 px-3 py-1 rounded-full"><%= lesson.book %></span>
                        <span class="text-xs font-semibold text-slate-500">📅 <%= lesson.date %></span>
                    </div>
                    <h1 class="text-2xl font-bold text-slate-900 mt-2"><%= lesson.title %></h1>
                    <p class="text-slate-600 text-sm mt-1">Defter notlarından derlenen diyalog kalıpları, zamirler, sayılar ve ders içi ipuçları.</p>
                </div>
            </div>

            <!-- Kritik İpuçları & Defter Düzeltmeleri -->
            <% if (lesson.summary && lesson.summary.notes && lesson.summary.notes.length > 0) { %>
                <div class="bg-amber-50 border border-amber-200 rounded-2xl p-5">
                    <h3 class="text-sm font-bold text-amber-900 flex items-center gap-2 mb-2.5">
                        <span>💡</span> Dersin Kritik İpuçları & Defter Düzeltmeleri
                    </h3>
                    <ul class="space-y-2 text-xs sm:text-sm text-amber-800">
                        <% lesson.summary.notes.forEach(function(note) { %>
                            <li class="flex items-start gap-2">
                                <span class="font-bold text-amber-600">•</span>
                                <span><%= note %></span>
                            </li>
                        <% }); %>
                    </ul>
                </div>
            <% } %>

            <!-- Tanışma ve Temel Soru-Cevap Kalıpları -->
            <% if (lesson.summary && lesson.summary.dialogs && lesson.summary.dialogs.length > 0) { %>
                <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200">
                    <h2 class="text-lg font-bold text-indigo-700 mb-4 flex items-center gap-2">
                        <span>1️⃣</span> Tanışma ve Temel Soru-Cevap Kalıpları
                    </h2>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-sm border-collapse">
                            <thead>
                                <tr class="bg-slate-100 text-slate-700 border-b border-slate-200">
                                    <th class="p-3 font-semibold">Soru Kalıbı (Almanca)</th>
                                    <th class="p-3 font-semibold">Örnek Yanıt</th>
                                    <th class="p-3 font-semibold">Türkçe Karşılığı & Not</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                <% lesson.summary.dialogs.forEach(function(d) { %>
                                    <tr class="hover:bg-slate-50 transition-colors">
                                        <td class="p-3 font-bold text-indigo-600"><%= d.q %></td>
                                        <td class="p-3 font-medium text-emerald-700"><%= d.a %></td>
                                        <td class="p-3 text-slate-600 text-xs sm:text-sm"><%= d.tr %></td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>
            <% } %>

            <!-- Şahıs Zamirleri ve Sayılar Grid -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <!-- Şahıs Zamirleri -->
                <% if (lesson.summary && lesson.summary.pronouns && lesson.summary.pronouns.length > 0) { %>
                    <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200">
                        <h2 class="text-lg font-bold text-indigo-700 mb-4 flex items-center gap-2">
                            <span>2️⃣</span> Şahıs Zamirleri ve Çekim Kuralı
                        </h2>
                        <div class="space-y-2.5">
                            <% lesson.summary.pronouns.forEach(function(p) { %>
                                <div class="p-3 bg-slate-50 rounded-xl border border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                                    <div>
                                        <span class="font-bold text-indigo-700 text-base"><%= p.de %></span>
                                        <span class="text-slate-600 text-sm ml-2">→ <%= p.tr %></span>
                                    </div>
                                    <span class="text-xs bg-white px-2.5 py-1 rounded-md border border-slate-200 text-slate-500 font-medium"><%= p.note %></span>
                                </div>
                            <% }); %>
                        </div>
                    </div>
                <% } %>

                <!-- Sayılar (Die Zahlen) -->
                <% if (lesson.summary && lesson.summary.numbers && lesson.summary.numbers.length > 0) { %>
                    <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200">
                        <div class="flex items-center justify-between mb-4">
                            <h2 class="text-lg font-bold text-indigo-700 flex items-center gap-2">
                                <span>3️⃣</span> Sayılar (Die Zahlen)
                            </h2>
                            <span class="text-xs bg-rose-50 text-rose-700 border border-rose-200 px-2.5 py-1 rounded-full font-semibold">⚠️ İstisna Yazılışlar</span>
                        </div>
                        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 text-xs sm:text-sm max-h-96 overflow-y-auto custom-scrollbar pr-1">
                            <% lesson.summary.numbers.forEach(function(n) { %>
                                <div class="p-2.5 rounded-lg border <%= n.de.includes('⚠️') ? 'bg-rose-50 border-rose-200 text-rose-900 font-semibold' : 'bg-slate-50 border-slate-200 text-slate-700' %>">
                                    <span class="font-bold text-indigo-600"><%= n.num %></span> = <%= n.de %>
                                </div>
                            <% }); %>
                        </div>
                    </div>
                <% } %>
            </div>
        </section>

        <!-- SEKME 2: FİİL REHBERİ -->
        <section id="tab-verbs" class="tab-content hidden space-y-6">
            <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div>
                    <h1 class="text-2xl font-bold text-slate-900">Fiil Çekim Rehberi (Konjugation)</h1>
                    <p class="text-slate-600 text-sm">Bu derste öğrenilen fiillerin tüm şahıslara göre çekimleri.</p>
                </div>
                <div class="w-full sm:w-72">
                    <input type="text" id="verb-search" oninput="searchVerbs()" placeholder="Fiil veya Türkçe anlam ara..." class="w-full px-4 py-2 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="verb-grid"></div>
        </section>

        <!-- SEKME 3: SÖZLÜK (DERSTEKİ KELİMELER) -->
        <section id="tab-dictionary" class="tab-content hidden space-y-6">
            <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div>
                    <h1 class="text-2xl font-bold text-slate-900">Dersteki Kelimeler & Kalıplar Sözlüğü</h1>
                    <p class="text-slate-600 text-sm">Derste geçen selamlaşma, vedalaşma ve temel kelimeler.</p>
                </div>
                <div class="w-full sm:w-72">
                    <input type="text" id="dict-search" oninput="renderDictionary()" placeholder="Almanca veya Türkçe kelime ara..." class="w-full px-4 py-2 border border-slate-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                </div>
            </div>

            <!-- Dinamik Sözlük Kategori Butonları -->
            <% const dictCategories = [...new Set((lesson.dictionary || []).map(item => item.cat))]; %>
            <div class="flex flex-wrap gap-2 text-xs" id="dict-cat-buttons">
                <button onclick="setDictCat('all', this)" class="dict-cat-btn px-3.5 py-1.5 rounded-full bg-indigo-600 text-white font-semibold transition">
                    Tümü (<%= lesson.dictionary.length %>)
                </button>
                <% dictCategories.forEach(function(cat) { %>
                    <button onclick="setDictCat('<%= cat %>', this)" class="dict-cat-btn px-3.5 py-1.5 rounded-full bg-slate-200 text-slate-700 font-semibold hover:bg-slate-300 transition">
                        <%= cat %>
                    </button>
                <% }); %>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" id="dict-grid"></div>
        </section>

        <!-- SEKME 4: ÇALIŞMA KARTLARI (FLASHCARDS) -->
        <section id="tab-flashcards" class="tab-content hidden space-y-6">
            <% 
                const fcCatLabels = {
                    tanisma: '👋 Tanışma',
                    selam: '🚪 Selam & Veda',
                    fiiller: '🔄 Fiiller',
                    sayilar: '🔢 Sayılar'
                };
                const fcCategories = [...new Set((lesson.flashcards || []).map(item => item.cat))];
            %>
            <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4">
                <div>
                    <h1 class="text-2xl font-bold text-slate-900">İnteraktif Çalışma Kartları</h1>
                    <p class="text-slate-600 text-sm">Kartın üzerine tıklayarak cevabı görün.</p>
                </div>
                <div class="flex flex-wrap gap-2 text-xs">
                    <button onclick="filterCards('all', this)" class="fc-filter-btn px-3.5 py-1.5 rounded-full bg-indigo-600 text-white font-semibold transition">
                        Hepsi (<%= lesson.flashcards.length %>)
                    </button>
                    <% fcCategories.forEach(function(cat) { %>
                        <button onclick="filterCards('<%= cat %>', this)" class="fc-filter-btn px-3.5 py-1.5 rounded-full bg-slate-200 text-slate-700 font-semibold hover:bg-slate-300 transition">
                            <%= fcCatLabels[cat] || cat.toUpperCase() %>
                        </button>
                    <% }); %>
                </div>
            </div>

            <div class="max-w-xl mx-auto">
                <div class="perspective-1000 w-full h-72 cursor-pointer select-none" onclick="toggleCardFlip()">
                    <div id="flashcard-inner" class="relative w-full h-full transform-style-3d transition-transform duration-500 rounded-2xl shadow-md border border-slate-200">
                        <!-- Ön Yüz -->
                        <div class="absolute inset-0 w-full h-full bg-white rounded-2xl p-8 flex flex-col justify-between items-center text-center backface-hidden">
                            <span class="text-xs font-bold uppercase tracking-wider text-indigo-600 bg-indigo-50 px-3 py-1 rounded-full" id="fc-category">Soru Kartı</span>
                            <div class="my-auto">
                                <h3 class="text-xl sm:text-2xl font-bold text-slate-800" id="fc-question">Yükleniyor...</h3>
                            </div>
                            <p class="text-xs text-slate-400">💡 Cevabı görmek için karta tıklayın</p>
                        </div>
                        <!-- Arka Yüz -->
                        <div class="absolute inset-0 w-full h-full bg-indigo-900 text-white rounded-2xl p-8 flex flex-col justify-between items-center text-center backface-hidden rotate-y-180">
                            <span class="text-xs font-bold uppercase tracking-wider text-indigo-200 bg-indigo-800 px-3 py-1 rounded-full">Doğru Yanıt & Açıklama</span>
                            <div class="my-auto space-y-2">
                                <h3 class="text-2xl font-extrabold text-amber-300" id="fc-answer">Cevap</h3>
                                <p class="text-xs sm:text-sm text-indigo-100 max-w-md mx-auto" id="fc-explain">Açıklama</p>
                            </div>
                            <p class="text-xs text-indigo-300">🔄 Çevirmek için tekrar tıklayın</p>
                        </div>
                    </div>
                </div>

                <div class="flex items-center justify-between mt-6">
                    <button onclick="prevCard()" class="px-4 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 font-semibold rounded-xl text-sm transition">⬅️ Önceki</button>
                    <span class="text-xs font-bold text-slate-500" id="fc-counter">1 / 1</span>
                    <button onclick="nextCard()" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl text-sm transition">Sonraki ➡️</button>
                </div>
            </div>
        </section>

        <!-- SEKME 5: ALIŞTIRMA SORULARI (BOŞLUK DOLDURMA) -->
        <section id="tab-exercises" class="tab-content hidden space-y-6">
            <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div>
                    <h1 class="text-2xl font-bold text-slate-900">Boşluk Doldurma Alıştırmaları</h1>
                    <p class="text-slate-600 text-sm">Cevabı yazıp Enter'a basın veya Kontrol butonuna tıklayın. Özel harfler için <b>ß, ä, ö, ü</b> tuşlarını kullanabilirsiniz.</p>
                </div>
                <div class="flex gap-2">
                    <button onclick="resetExercises()" class="px-4 py-2.5 bg-slate-200 hover:bg-slate-300 text-slate-700 font-semibold rounded-xl text-xs sm:text-sm transition whitespace-nowrap">🔄 Temizle</button>
                    <button onclick="checkAllExercises()" class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl text-xs sm:text-sm transition whitespace-nowrap">✅ Tümünü Kontrol Et</button>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4" id="exercises-container"></div>
        </section>

        <!-- SEKME 6: DERS SONU SINAVI & PERFORMANS ANALİZİ -->
        <section id="tab-quiz" class="tab-content hidden space-y-8">
            <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div>
                    <h1 class="text-2xl font-bold text-slate-900">Ders Sonu Sınavı & Performans Analizi</h1>
                    <p class="text-slate-600 text-sm"><%= lesson.quiz.length %> soruluk ders sonu değerlendirme testi ve konu bazlı başarı grafiği.</p>
                </div>
                <button onclick="resetQuiz()" class="px-4 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 font-semibold rounded-xl text-xs sm:text-sm transition">🔄 Sınavı Sıfırla</button>
            </div>

            <!-- KPI Kartları -->
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between">
                    <div>
                        <p class="text-xs font-semibold text-slate-500 uppercase">Toplam Soru</p>
                        <p class="text-3xl font-extrabold text-slate-800 mt-1" id="stat-total"><%= lesson.quiz.length %></p>
                    </div>
                    <span class="text-2xl sm:text-3xl p-3 bg-indigo-50 rounded-lg">📋</span>
                </div>
                <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between">
                    <div>
                        <p class="text-xs font-semibold text-slate-500 uppercase">Doğru Yanıt</p>
                        <p class="text-3xl font-extrabold text-emerald-600 mt-1" id="stat-correct">0</p>
                    </div>
                    <span class="text-2xl sm:text-3xl p-3 bg-emerald-50 rounded-lg">✅</span>
                </div>
                <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between">
                    <div>
                        <p class="text-xs font-semibold text-slate-500 uppercase">Yanlış Yanıt</p>
                        <p class="text-3xl font-extrabold text-rose-600 mt-1" id="stat-wrong">0</p>
                    </div>
                    <span class="text-2xl sm:text-3xl p-3 bg-rose-50 rounded-lg">❌</span>
                </div>
                <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between">
                    <div>
                        <p class="text-xs font-semibold text-slate-500 uppercase">Başarı Oranı</p>
                        <p class="text-3xl font-extrabold text-indigo-600 mt-1" id="stat-rate">%0</p>
                    </div>
                    <span class="text-2xl sm:text-3xl p-3 bg-indigo-50 rounded-lg">🎯</span>
                </div>
            </div>

            <!-- Grafikler -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
                    <h3 class="text-base font-bold text-slate-800 mb-3">📊 Genel Doğruluk Dağılımı</h3>
                    <div class="chart-container">
                        <canvas id="doughnutChart"></canvas>
                    </div>
                </div>
                <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
                    <h3 class="text-base font-bold text-slate-800 mb-3">🎯 Konu Bazlı Performans</h3>
                    <div class="chart-container">
                        <canvas id="barChart"></canvas>
                    </div>
                </div>
            </div>

            <!-- Filtreleme ve Sorular Listesi -->
            <div class="flex flex-wrap items-center justify-between gap-2 pt-2">
                <h2 class="text-lg font-bold text-slate-800">Sınav Soruları</h2>
                <div class="flex gap-2">
                    <button onclick="filterQuiz('all', this)" class="q-filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-indigo-600 text-white">Tümü</button>
                    <button onclick="filterQuiz('wrong', this)" class="q-filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-rose-100 text-rose-700">Sadece Yanlışlarım</button>
                    <button onclick="filterQuiz('correct', this)" class="q-filter-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-emerald-100 text-emerald-700">Sadece Doğrularım</button>
                </div>
            </div>

            <div class="space-y-4" id="quiz-questions-container"></div>
        </section>

    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-slate-200 mt-auto py-5">
        <div class="max-w-7xl mx-auto px-4 text-center text-xs text-slate-500">
            <p>Almanca A1 İnteraktif Çalışma Portalı • Muhammet & Cansu • 2026</p>
        </div>
    </footer>

    <!-- Sunucu Verisi (VS Code Expression Expected Hatasını Önleyen JSON Bloğu) -->
    <script id="lesson-data" type="application/json">
        <%- JSON.stringify(lesson) %>
    </script>

    <!-- İstemci Tarafı JS -->
    <script>
        const lessonData = JSON.parse(document.getElementById('lesson-data').textContent);
        const verbsData = lessonData.verbs || [];
        const dictData = lessonData.dictionary || [];
        const allFlashcards = lessonData.flashcards || [];
        const exercisesData = lessonData.exercises || [];
        const quizQuestions = lessonData.quiz || [];

        const fcCatNames = {
            tanisma: 'Tanışma & Kalıplar',
            selam: 'Selamlaşma & Veda',
            fiiller: 'Fiil Çekimi',
            sayilar: 'Sayılar (Die Zahlen)'
        };

        let currentCardIndex = 0;
        let filteredCards = [...allFlashcards];
        let isFlipped = false;
        let currentDictCat = 'all';
        let userQuizAnswers = {};
        let currentQuizFilter = 'all';
        let doughnutChartInstance = null;
        let barChartInstance = null;

        document.addEventListener('DOMContentLoaded', () => {
            renderVerbs(verbsData);
            renderDictionary();
            renderFlashcard();
            renderExercises();
            renderQuiz();
            initCharts();
        });

        // Sekme Değiştirme
        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.getElementById(`tab-${tabId}`).classList.remove('hidden');

            document.querySelectorAll('.nav-btn').forEach(btn => {
                btn.classList.remove('bg-indigo-900', 'text-white');
                btn.classList.add('hover:bg-indigo-600', 'text-indigo-100');
            });
            const activeBtn = document.getElementById(`nav-${tabId}`);
            if (activeBtn) {
                activeBtn.classList.add('bg-indigo-900', 'text-white');
                activeBtn.classList.remove('hover:bg-indigo-600', 'text-indigo-100');
            }
        }

        // Fiil Rehberi
        function renderVerbs(verbs) {
            const grid = document.getElementById('verb-grid');
            if (verbs.length === 0) {
                grid.innerHTML = `<div class="col-span-full text-center py-8 text-slate-400 text-sm">Aramanızla eşleşen fiil bulunamadı.</div>`;
                return;
            }
            grid.innerHTML = verbs.map(v => `
                <div class="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm hover:shadow-md transition">
                    <div class="flex justify-between items-start mb-3">
                        <div>
                            <h3 class="text-xl font-bold text-indigo-700">${v.name}</h3>
                            <p class="text-xs font-semibold text-slate-500">${v.tr}</p>
                        </div>
                        <span class="text-xs px-2.5 py-1 rounded-full font-bold ${v.type.includes('Düzensiz') ? 'bg-amber-100 text-amber-800' : 'bg-emerald-100 text-emerald-800'}">
                            ${v.type}
                        </span>
                    </div>
                    <div class="grid grid-cols-2 gap-2 text-xs bg-slate-50 p-3.5 rounded-xl border border-slate-100 font-mono">
                        <div><span class="text-slate-400">ich:</span> <span class="font-bold text-slate-800">${v.conj.ich}</span></div>
                        <div><span class="text-slate-400">wir:</span> <span class="font-bold text-slate-800">${v.conj.wir}</span></div>
                        <div><span class="text-slate-400">du:</span> <span class="font-bold text-indigo-600">${v.conj.du}</span></div>
                        <div><span class="text-slate-400">ihr:</span> <span class="font-bold text-slate-800">${v.conj.ihr}</span></div>
                        <div><span class="text-slate-400">er/sie/es:</span> <span class="font-bold text-indigo-600">${v.conj.er}</span></div>
                        <div><span class="text-slate-400">sie/Sie:</span> <span class="font-bold text-slate-800">${v.conj.sie}</span></div>
                    </div>
                </div>
            `).join('');
        }

        function searchVerbs() {
            const q = document.getElementById('verb-search').value.toLowerCase();
            renderVerbs(verbsData.filter(v => v.name.toLowerCase().includes(q) || v.tr.toLowerCase().includes(q)));
        }

        // Sözlük
        function setDictCat(cat, btnEl) {
            currentDictCat = cat;
            document.querySelectorAll('.dict-cat-btn').forEach(b => {
                b.classList.remove('bg-indigo-600', 'text-white');
                b.classList.add('bg-slate-200', 'text-slate-700');
            });
            btnEl.classList.add('bg-indigo-600', 'text-white');
            btnEl.classList.remove('bg-slate-200', 'text-slate-700');
            renderDictionary();
        }

        function renderDictionary() {
            const q = (document.getElementById('dict-search')?.value || '').toLowerCase();
            const filtered = dictData.filter(item => {
                const matchCat = currentDictCat === 'all' || item.cat === currentDictCat;
                const matchQ = item.de.toLowerCase().includes(q) || item.tr.toLowerCase().includes(q);
                return matchCat && matchQ;
            });

            const grid = document.getElementById('dict-grid');
            if (filtered.length === 0) {
                grid.innerHTML = `<div class="col-span-full text-center py-8 text-slate-400 text-sm">Aramanızla eşleşen kelime bulunamadı.</div>`;
                return;
            }

            grid.innerHTML = filtered.map(item => `
                <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm hover:border-indigo-300 transition flex flex-col justify-between">
                    <div>
                        <span class="text-[11px] font-semibold text-indigo-600 bg-indigo-50 px-2 py-0.5 rounded">${item.cat}</span>
                        <h4 class="text-base font-bold text-slate-900 mt-2">${item.de}</h4>
                    </div>
                    <p class="text-sm text-slate-600 mt-1 font-medium">${item.tr}</p>
                </div>
            `).join('');
        }

        // Çalışma Kartları
        function toggleCardFlip() {
            const cardInner = document.getElementById('flashcard-inner');
            isFlipped = !isFlipped;
            cardInner.classList.toggle('rotate-y-180', isFlipped);
        }

        function renderFlashcard() {
            if (filteredCards.length === 0) return;
            const card = filteredCards[currentCardIndex];
            isFlipped = false;
            document.getElementById('flashcard-inner').classList.remove('rotate-y-180');

            setTimeout(() => {
                document.getElementById('fc-category').innerText = fcCatNames[card.cat] || card.cat.toUpperCase();
                document.getElementById('fc-question').innerText = card.q;
                document.getElementById('fc-answer').innerText = card.a;
                document.getElementById('fc-explain').innerText = card.exp;
                document.getElementById('fc-counter').innerText = `${currentCardIndex + 1} / ${filteredCards.length}`;
            }, 120);
        }

        function nextCard() {
            currentCardIndex = (currentCardIndex + 1) % filteredCards.length;
            renderFlashcard();
        }

        function prevCard() {
            currentCardIndex = (currentCardIndex - 1 + filteredCards.length) % filteredCards.length;
            renderFlashcard();
        }

        function filterCards(cat, btnEl) {
            document.querySelectorAll('.fc-filter-btn').forEach(btn => {
                btn.classList.remove('bg-indigo-600', 'text-white');
                btn.classList.add('bg-slate-200', 'text-slate-700');
            });
            btnEl.classList.add('bg-indigo-600', 'text-white');
            btnEl.classList.remove('bg-slate-200', 'text-slate-700');

            filteredCards = cat === 'all' ? [...allFlashcards] : allFlashcards.filter(c => c.cat === cat);
            currentCardIndex = 0;
            renderFlashcard();
        }

        // Boşluk Doldurma Alıştırmaları
        function renderExercises() {
            const container = document.getElementById('exercises-container');
            container.innerHTML = exercisesData.map((ex, i) => `
                <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm space-y-2 transition-colors" id="ex-card-${i}">
                    <div class="flex justify-between items-center">
                        <span class="text-xs font-bold text-slate-400">Alıştırma #${i + 1}</span>
                        <span class="text-xs text-indigo-600 bg-indigo-50 px-2 py-0.5 rounded font-medium">İpucu: ${ex.hint}</span>
                    </div>
                    <p class="text-sm font-semibold text-slate-800">${ex.sentence}</p>
                    <div class="flex flex-wrap gap-1.5 items-center pt-1">
                        <input type="text" id="ex-input-${i}" onkeydown="if(event.key==='Enter') checkExercise(${i})" placeholder="Cevabınızı yazın..." class="flex-grow min-w-[140px] px-3 py-1.5 text-sm border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
                        <button type="button" onclick="insertChar(${i}, 'ß')" class="px-2 py-1.5 bg-slate-100 hover:bg-slate-200 rounded text-xs font-bold">ß</button>
                        <button type="button" onclick="insertChar(${i}, 'ä')" class="px-2 py-1.5 bg-slate-100 hover:bg-slate-200 rounded text-xs font-bold">ä</button>
                        <button type="button" onclick="insertChar(${i}, 'ö')" class="px-2 py-1.5 bg-slate-100 hover:bg-slate-200 rounded text-xs font-bold">ö</button>
                        <button type="button" onclick="insertChar(${i}, 'ü')" class="px-2 py-1.5 bg-slate-100 hover:bg-slate-200 rounded text-xs font-bold">ü</button>
                        <button type="button" onclick="checkExercise(${i})" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-900 text-white text-xs font-semibold rounded-lg">Kontrol</button>
                    </div>
                    <p id="ex-feedback-${i}" class="text-xs font-semibold hidden"></p>
                </div>
            `).join('');
        }

        function insertChar(idx, char) {
            const input = document.getElementById(`ex-input-${idx}`);
            input.value += char;
            input.focus();
        }

        function checkExercise(idx) {
            const card = document.getElementById(`ex-card-${idx}`);
            const input = document.getElementById(`ex-input-${idx}`);
            const feedback = document.getElementById(`ex-feedback-${idx}`);
            const userVal = input.value.trim().toLowerCase();
            const correctVal = exercisesData[idx].answer.toLowerCase();

            feedback.classList.remove('hidden', 'text-emerald-700', 'text-rose-700');
            card.classList.remove('border-slate-200', 'border-emerald-300', 'bg-emerald-50/40', 'border-rose-300', 'bg-rose-50/40');

            if (userVal === correctVal) {
                feedback.innerText = `✅ Doğru! (${exercisesData[idx].answer})`;
                feedback.classList.add('text-emerald-700');
                card.classList.add('border-emerald-300', 'bg-emerald-50/40');
            } else {
                feedback.innerText = `❌ Doğru yanıt: "${exercisesData[idx].answer}" olmalıydı.`;
                feedback.classList.add('text-rose-700');
                card.classList.add('border-rose-300', 'bg-rose-50/40');
            }
        }

        function checkAllExercises() {
            exercisesData.forEach((_, i) => checkExercise(i));
        }

        function resetExercises() {
            renderExercises();
        }

        // Ders Sonu Sınavı & İstatistikler
        function selectQuizOption(qIdx, optIdx) {
            userQuizAnswers[qIdx] = quizQuestions[qIdx].options[optIdx];
            renderQuiz();
            updateQuizStatsAndCharts();
        }

        function resetQuiz() {
            userQuizAnswers = {};
            renderQuiz();
            updateQuizStatsAndCharts();
        }

        function filterQuiz(filter, btnEl) {
            currentQuizFilter = filter;
            document.querySelectorAll('.q-filter-btn').forEach(b => b.classList.remove('bg-indigo-600', 'text-white'));
            btnEl.classList.add('bg-indigo-600', 'text-white');
            renderQuiz();
        }

        function renderQuiz() {
            const container = document.getElementById('quiz-questions-container');
            const htmlItems = quizQuestions.map((q, idx) => {
                const userAns = userQuizAnswers[idx];
                const isAnswered = userAns !== undefined;
                const isCorrect = userAns === q.correct;

                if (currentQuizFilter === 'wrong' && (!isAnswered || isCorrect)) return '';
                if (currentQuizFilter === 'correct' && (!isAnswered || !isCorrect)) return '';

                return `
                    <div class="p-5 rounded-2xl border ${!isAnswered ? 'bg-white border-slate-200' : isCorrect ? 'bg-emerald-50/60 border-emerald-200' : 'bg-rose-50/60 border-rose-200'} shadow-sm">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-xs font-bold px-2.5 py-0.5 rounded bg-slate-100 text-slate-600">Soru ${idx + 1} • ${q.cat}</span>
                            ${isAnswered ? `<span class="text-xs font-bold ${isCorrect ? 'text-emerald-600' : 'text-rose-600'}">${isCorrect ? '✅ Doğru' : '❌ Yanlış'}</span>` : ''}
                        </div>
                        <p class="font-bold text-slate-800 text-sm sm:text-base mb-3">${q.q}</p>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                            ${q.options.map((opt, optIdx) => {
                                let btnStyle = 'bg-slate-50 hover:bg-indigo-50 border-slate-200 text-slate-700';
                                if (isAnswered) {
                                    if (opt === q.correct) btnStyle = 'bg-emerald-600 text-white border-emerald-600 font-bold';
                                    else if (opt === userAns) btnStyle = 'bg-rose-600 text-white border-rose-600 font-bold';
                                }
                                return `<button onclick="selectQuizOption(${idx}, ${optIdx})" class="text-left px-4 py-2.5 rounded-xl border text-xs sm:text-sm transition ${btnStyle}">${opt}</button>`;
                            }).join('')}
                        </div>
                        ${isAnswered ? `<p class="mt-3 text-xs text-slate-600 bg-white/90 p-2.5 rounded-lg border border-slate-200">💡 <b>Açıklama:</b> ${q.exp}</p>` : ''}
                    </div>
                `;
            }).filter(Boolean);

            container.innerHTML = htmlItems.length > 0
                ? htmlItems.join('')
                : `<div class="bg-white p-8 rounded-2xl border border-slate-200 text-center text-slate-400 text-sm">Bu filtreye uygun yanıtlanmış soru bulunmuyor.</div>`;
        }

        function initCharts() {
            const ctx1 = document.getElementById('doughnutChart').getContext('2d');
            doughnutChartInstance = new Chart(ctx1, {
                type: 'doughnut',
                data: {
                    labels: ['Doğru', 'Yanlış', 'Boş'],
                    datasets: [{
                        data: [0, 0, quizQuestions.length],
                        backgroundColor: ['#10b981', '#f43f5e', '#e2e8f0'],
                        borderWidth: 0
                    }]
                },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } }
            });

            const categories = [...new Set(quizQuestions.map(q => q.cat))];
            const ctx2 = document.getElementById('barChart').getContext('2d');
            barChartInstance = new Chart(ctx2, {
                type: 'bar',
                data: {
                    labels: categories,
                    datasets: [
                        { label: 'Doğru', data: categories.map(() => 0), backgroundColor: '#10b981' },
                        { label: 'Yanlış', data: categories.map(() => 0), backgroundColor: '#f43f5e' }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: { x: { stacked: true }, y: { stacked: true, beginAtZero: true } },
                    plugins: { legend: { position: 'bottom' } }
                }
            });
        }

        function updateQuizStatsAndCharts() {
            let correct = 0;
            let wrong = 0;
            const categories = [...new Set(quizQuestions.map(q => q.cat))];
            const catCorrect = {};
            const catWrong = {};
            categories.forEach(c => { catCorrect[c] = 0; catWrong[c] = 0; });

            quizQuestions.forEach((q, idx) => {
                const ans = userQuizAnswers[idx];
                if (ans !== undefined) {
                    if (ans === q.correct) {
                        correct++;
                        catCorrect[q.cat]++;
                    } else {
                        wrong++;
                        catWrong[q.cat]++;
                    }
                }
            });

            const unanswered = quizQuestions.length - (correct + wrong);
            const rate = quizQuestions.length > 0 ? Math.round((correct / quizQuestions.length) * 100) : 0;

            document.getElementById('stat-correct').innerText = correct;
            document.getElementById('stat-wrong').innerText = wrong;
            document.getElementById('stat-rate').innerText = `%${rate}`;

            doughnutChartInstance.data.datasets[0].data = [correct, wrong, unanswered];
            doughnutChartInstance.update();

            barChartInstance.data.datasets[0].data = categories.map(c => catCorrect[c]);
            barChartInstance.data.datasets[1].data = categories.map(c => catWrong[c]);
            barChartInstance.update();
        }
    </script>
</body>
</html>